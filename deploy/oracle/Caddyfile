# Managed by deploy/oracle/setup.sh ({{DOMAIN}} is filled in at install)
# Caddy gets and renews the HTTPS certificates itself and proxies the
# dashboard's WebSocket without extra config.

www.{{DOMAIN}} {
	redir https://{{DOMAIN}}{uri} permanent
}

{{DOMAIN}} {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3001
}
