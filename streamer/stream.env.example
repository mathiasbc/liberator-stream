# Streamer settings. `make stream-config` copies this to stream.env, which git
# ignores. Never commit stream.env: the stream key lets anyone broadcast to
# your channel.

# YouTube Studio > Go live > Stream tab. Use a persistent key, with auto-start
# on and auto-stop off. The streamer waits until this is filled in and picks it
# up within 30 seconds; after changing it later, run `make services-restart`.
YOUTUBE_STREAM_KEY=

# Optional overrides (defaults shown)
# YOUTUBE_INGEST_URL=rtmps://a.rtmps.youtube.com/live2
# DASHBOARD_URL=http://localhost:3001
# FPS=30
# VIDEO_BITRATE_KBPS=4500
# KEYFRAME_SECONDS=2
# JPEG_QUALITY=80
# CHROME_RESTART_HOURS=24

# Music: audio files in streamer/music play on a loop, shuffled, levelled to
# -16 LUFS. See streamer/music/README.md for sources that are safe on YouTube.
# MUSIC_DIR=streamer/music
# MUSIC_VOLUME=1
# MUSIC_LOUDNORM=on

# Live title that follows the price, e.g. "Bitcoin $82,201 ▲ 0.8% · live 24/7".
# Needs a Google Cloud project with the YouTube Data API v3 enabled and an
# OAuth client of type "Desktop app"; put its id and secret here, then run
# `make youtube-auth` once to sign in (it fills YOUTUBE_REFRESH_TOKEN).
# Each update costs 51 of the API's 10,000 daily quota units.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# YOUTUBE_TITLE_TEMPLATE=Bitcoin {price} {arrow} {change} · live 24/7
# TITLE_UPDATE_MINUTES=10

# Testing: send the stream here instead of YouTube (a .flv file path or an
# rtmp:// URL)
# STREAM_OUTPUT=
